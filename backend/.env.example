# ===== REQUIRED =====
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/cafe_db
JWT_SECRET=change_this_to_a_long_random_string_64_chars

# ===== OPTIONAL =====
JWT_EXPIRES_IN=18h

# For production on Render: set CLIENT_URL to your Render app URL
# e.g. https://study-cafe.onrender.com
CLIENT_URL=http://localhost:5173
